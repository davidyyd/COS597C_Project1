#!/bin/bash
# Inside the jail: export each /run/ar_secrets/NAME file as the environment variable NAME, then run the command.
# The launcher passes the agent's login this way (tools/jail.py) so that it never appears on a command line.
for f in /run/ar_secrets/*; do
    [ -f "$f" ] && export "$(basename "$f")=$(cat "$f")"
done
exec "$@"
